{
  "expo": {
    "name": "UDECA",
    "slug": "udeca",
    "scheme": [
      "udeca",
      "entrenadores.app",
      "com.udeca.app"
    ],
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.udeca.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSMotionUsageDescription": "Para contar los pasos que das cada día y sumarlos a tu plan de nutrición, sin que tengas que apuntarlos a mano."
      }
    },
    "android": {
      "package": "entrenadores.app",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static",
      "backgroundColor": "#000000"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Para elegir tu foto de perfil, subir tus fotos de progreso y, si eres entrenador, las fotos de tus libretas de comida.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E0242F"
        }
      ],
      "expo-apple-authentication",
      "./plugins/memoria-de-gradle",
      "./plugins/optimizar-android"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "c649314b-a914-41df-9930-563ad5a17953"
      }
    },
    "locales": {
      "es": "./locales/es.json",
      "en": "./locales/en.json"
    }
  }
}

# Copia este archivo como ".env" y rellena los valores con los de tu proyecto
# de Firebase (Configuración del proyecto > Tus apps > Config del SDK).
# Las variables deben empezar por EXPO_PUBLIC_ para que Expo las incluya
# en el bundle de la app (cliente, web, iOS y Android).

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Entrar con Google en MÓVIL (en web no hace falta ninguno de estos: lo
# resuelve Firebase solo con el proveedor de Google activado en su consola).
#
# Se crean en Google Cloud → APIs y servicios → Credenciales, en el MISMO
# proyecto que Firebase, uno por plataforma. Son públicos por diseño (viajan
# dentro de la app), así que no son secretos: lo que protege la cuenta es el
# identificador de la app declarado junto al cliente.
#
# Sin ellos, el botón de Google no aparece en móvil (y no falla al pulsarlo).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

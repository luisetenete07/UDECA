firestore-debug.log
firebase-debug.log
ui-debug.log
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Credenciales de cuenta de servicio de Firebase/Google: son claves privadas y
# solo deben vivir como secreto (GitHub Actions / Vercel), nunca en el repo.
*serviceAccount*.json
*service-account*.json
*-firebase-adminsdk-*.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem


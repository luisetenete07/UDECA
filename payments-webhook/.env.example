# Copia este archivo como .env.local para pruebas en local (NO lo subas a git).
# En producción, estas variables se ponen en Vercel → Project → Settings → Environment Variables.

# Clave secreta de tu cuenta de Stripe (Developers → API keys).
STRIPE_SECRET_KEY=sk_live_xxx

# Secreto del webhook (Developers → Webhooks → tu endpoint → Signing secret).
STRIPE_WEBHOOK_SECRET=whsec_xxx

# JSON de la cuenta de servicio de Firebase, en UNA sola línea.
# (Firebase Console → Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}

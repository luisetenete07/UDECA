rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Mapa público código -> trainerId, usado solo para vincular clientes
    // a su entrenador durante el registro. No contiene datos personales.
    match /trainerCodes/{code} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.trainerId == request.auth.uid;
      // El dueño puede reescribir o liberar sus propios códigos; nadie puede
      // apropiarse del código de otro entrenador (create solo aplica si el
      // documento no existe; update solo si ya es tuyo).
      //
      // El documento lleva además `full`: lo marca la app del entrenador cuando
      // llena su plan gratuito, para que un alumno nuevo no pueda vincularse y
      // dejarle por encima del límite sin que él haya hecho nada. Al exigir que
      // `trainerId` siga siendo el suyo, solo él puede tocarlo.
      allow update: if request.auth != null
        && resource.data.trainerId == request.auth.uid
        && request.resource.data.trainerId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.trainerId == request.auth.uid;
    }

    // Solicitudes de alumnos para unirse al grupo de un entrenador. El alumno
    // crea la suya (clientId == él) y puede cancelarla; el entrenador
    // destinatario la lee y la borra (al aceptar o rechazar). No se editan.
    match /joinRequests/{reqId} {
      allow read: if request.auth != null
        && (resource.data.clientId == request.auth.uid
          || resource.data.trainerId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.clientId == request.auth.uid;
      allow delete: if request.auth != null
        && (resource.data.clientId == request.auth.uid
          || resource.data.trainerId == request.auth.uid);
      allow update: if false;
    }

    // Perfiles de usuario (entrenadores y clientes).
    match /users/{userId} {
      // Admin de la plataforma UDECA: gestiona las suscripciones de los
      // coaches (modelo SaaS). Identificado por su correo verificado.
      function isUdecaAdmin() {
        return request.auth != null
          && request.auth.token.email in [
            'luisetenete07@gmail.com',
            'luistenaf@gmail.com'
          ];
      }
      /**
       * ¿Le caben más alumnos al entrenador que llama?
       *
       * Se apoya en `clientCount`, que solo puede escribir el servidor (ver la
       * regla de update de abajo): por eso es un dato de confianza y sirve para
       * imponer aquí el límite del plan gratuito. Si lo escribiera el propio
       * coach, bastaría con ponerlo a cero para tener alumnos infinitos gratis.
       *
       * El 5 de abajo es FREE_CLIENT_LIMIT (los alumnos que incluye el alta de
       * 1 €). Vive en tres sitios que no pueden importarse entre sí:
       * lib/subscription.ts (app), payments-webhook/api/join.js (servidor) y
       * aquí. Si lo cambias, cámbialo en los tres.
       *
       * `clientSlots` lo escribe SOLO el servidor y baja ese tope a cero cuando
       * el alta se pagó con una tarjeta que ya había gastado sus plazas en otra
       * cuenta de entrenador.
       */
      function coachWithinPlan() {
        let coach = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        return !('subscriptionUntil' in coach)
          || coach.subscriptionUntil > request.time.toMillis()
          || coach.get('clientCount', 0) < coach.get('clientSlots', 5);
      }
      allow read: if request.auth != null
        && (
          request.auth.uid == userId
          || resource.data.trainerId == request.auth.uid
          // El alumno puede leer el perfil de SU entrenador (p. ej. para
          // enviarle una notificación al completar una sesión).
          || userId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.trainerId
          || isUdecaAdmin()
        );
      // Al crearse, nadie puede regalarse tiempo de suscripción. Única
      // excepción: el ATLETA nace con su prueba gratuita, acotada aquí a 14
      // días para que no pueda pedirse más del que le corresponde (el mismo
      // número que TRIAL_DAYS en lib/subscription.ts). El
      // entrenador nace caducado (0) y se activa al pagar su cuota anual.
      allow create: if request.auth != null && request.auth.uid == userId
        && (
          // Los alumnos entran gratis: no llevan suscripción.
          (request.resource.data.role != 'trainer' && request.resource.data.role != 'athlete')
          || !('subscriptionUntil' in request.resource.data)
          || request.resource.data.subscriptionUntil <= request.time.toMillis()
          || (
            request.resource.data.role == 'athlete'
            && request.resource.data.subscriptionUntil
                 <= request.time.toMillis() + 14 * 24 * 60 * 60 * 1000
          )
        );
      // El propio usuario edita su perfil (sin tocar su suscripción); el
      // entrenador puede cambiar el `status` de sus clientes o sacarlos de su
      // grupo (quitar `trainerId`); el admin gestiona suscripciones.
      allow update: if request.auth != null && (
        (
          request.auth.uid == userId
          // Campos que decide el SERVIDOR y nadie más:
          //  - clientCount / clientSlots: cuántos alumnos tiene y cuántos le
          //    caben. Si pudiera escribirlos, se saltaría el límite poniendo
          //    el contador a cero o regalándose plazas.
          //  - entryPaidAt / payerFingerprint / sharedCardWith: el rastro del
          //    alta de 1 €. Es la prueba de qué tarjeta pagó, y falsificarla
          //    desmontaría el control de multicuentas entero.
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny([
              'subscriptionUntil', 'subscriptionPlan', 'clientCount',
              'clientSlots', 'entryPaidAt', 'payerFingerprint', 'sharedCardWith',
              // El número de fundador es correlativo y lo reparte el servidor.
              // Si cada uno se lo pusiera, mañana habría diez "fundador nº 1".
              'founderNumber', 'founderSince',
              // Si a un alumno se le pregunta el esfuerzo (RIR) lo decide su
              // ENTRENADOR, más abajo. Si pudiera quitárselo él, el entrenador
              // seguiría creyendo que ese dato existe y se le quedaría la
              // intensidad en blanco sin saber por qué. El atleta no lo
              // necesita: se le pregunta por su rol, no por este campo.
              'trackRir'
            ])
        )
        || (
          isUdecaAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['subscriptionUntil', 'subscriptionPlan'])
        )
        || (
          resource.data.trainerId == request.auth.uid
          && (
            // `billingAnchorDay` es el día del mes en que se le cobra a ese
            // alumno. Lo escribe el entrenador al confirmar un cobro (ver
            // lib/billing.ts); faltaba en esta lista, así que TODA confirmación
            // de pago se rechazaba con "permisos insuficientes".
            // `trackRir`: si a ese alumno se le pregunta el esfuerzo al
            // terminar cada ejercicio. Lo decide el entrenador, que es quien
            // sabe si su alumno entiende lo que es un RIR.
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'paymentStatus', 'monthlyFeeEur', 'nextPaymentDate', 'paymentReportedAt', 'billingAnchorDay', 'trackRir'])
            || (
              // Sacar del grupo: se elimina el vínculo con el entrenador.
              !('trainerId' in request.resource.data)
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['trainerId', 'status', 'paymentStatus', 'monthlyFeeEur', 'nextPaymentDate'])
            )
          )
        )
        || (
          // Aprobar solicitud: el entrenador se vincula a un alumno que le ha
          // enviado una solicitud (existe joinRequests/{clientId}_{coach}).
          //
          // Se mantiene como RESPALDO de las versiones ya publicadas de la app:
          // la actual aprueba por el servidor (payments-webhook/api/join), que
          // cuenta los alumnos con permisos de administrador. Aquí se impone el
          // mismo límite apoyándose en `clientCount`, que solo escribe el
          // servidor, para que este camino no sirva de puerta trasera.
          request.resource.data.trainerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trainerId'])
          && exists(/databases/$(database)/documents/joinRequests/$(userId + '_' + request.auth.uid))
          && get(/databases/$(database)/documents/joinRequests/$(userId + '_' + request.auth.uid)).data.clientId == userId
          && coachWithinPlan()
        )
      );
      // El propio usuario puede borrar su cuenta (su documento de perfil);
      // el admin de UDECA puede eliminar cuentas desde su panel.
      allow delete: if request.auth != null
        && (request.auth.uid == userId || isUdecaAdmin());
    }

    // Plantilla maestra de ejercicios de UDECA (colección global). La lee
    // cualquier usuario autenticado (para precargarla en su biblioteca); solo
    // el admin (CEO) puede crear/editar/borrar.
    match /templateExercises/{exerciseId} {
      function isUdecaAdmin() {
        return request.auth != null
          && request.auth.token.email in [
            'luisetenete07@gmail.com',
            'luistenaf@gmail.com'
          ];
      }
      allow read: if request.auth != null;
      allow create, update, delete: if isUdecaAdmin();
    }

    // Biblioteca de ejercicios de cada entrenador.
    match /exercises/{exerciseId} {
      allow read: if request.auth != null
        && (resource.data.trainerId == request.auth.uid
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.trainerId == resource.data.trainerId);
      allow create: if request.auth != null
        && request.resource.data.trainerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.trainerId == request.auth.uid;
    }

    // Notas privadas del entrenador sobre un alumno (doc id = clientId).
    match /coachNotes/{clientId} {
      // Si el alumno aún no tiene nota, el documento no existe (resource == null):
      // se permite la lectura para que el perfil cargue sin nota, sin exponer datos.
      allow read: if request.auth != null
        && (resource == null || resource.data.trainerId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.trainerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.trainerId == request.auth.uid;
    }

    // Qué ejercicios se siguen en la tabla de progreso de un alumno
    // (doc id = clientId).
    //
    // Lo LEEN los dos: el entrenador y el propio alumno, porque ven la misma
    // tabla y hablar del progreso mirando cosas distintas no lleva a ningún
    // sitio. Lo ESCRIBE solo el entrenador: es él quien decide qué se vigila.
    //
    // El atleta se autoentrena (su trainerId es su propio uid), así que esta
    // misma regla le deja editar la suya sin ninguna excepción especial.
    match /progressTrackers/{clientId} {
      // Quién puede leer se deduce del ALUMNO (el id del documento), no del
      // documento en sí: así funciona igual cuando todavía no existe, que es
      // lo normal hasta que el entrenador elige algo. Apoyarse en
      // `resource.data` obligaba a un `resource == null` que el motor de
      // reglas no siempre resuelve antes de evaluar el resto.
      allow read: if request.auth != null
        && (
          clientId == request.auth.uid
          || get(/databases/$(database)/documents/users/$(clientId)).data.trainerId
               == request.auth.uid
        );
      // Quien manda es EL ENTRENADOR ACTUAL del alumno, mirando el vínculo real
      // en `users`, no el `trainerId` que traiga guardado el documento.
      //
      // Importa por dos motivos. Uno: sin comprobar el vínculo, un alumno podía
      // crear él mismo el documento poniéndose de entrenador y quedarse con su
      // tabla. Dos: si un documento acabara con el dueño equivocado (por un
      // fallo o por un cambio de entrenador), fiarse de lo guardado lo dejaría
      // bloqueado para siempre; así el entrenador de turno siempre puede
      // recuperarlo.
      //
      // El atleta pasa la comprobación sin ninguna excepción: su `trainerId` es
      // su propio uid, así que es su propio entrenador.
      allow create: if request.auth != null
        && request.resource.data.trainerId == request.auth.uid
        && get(/databases/$(database)/documents/users/$(clientId)).data.trainerId
             == request.auth.uid;
      allow update, delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(clientId)).data.trainerId
             == request.auth.uid;
    }

    // Lecciones de curso vistas por cada alumno. Doc id = uid del alumno.
    //
    // Lo LEEN los dos: el alumno para ver por dónde va y su entrenador para
    // saber si alguien ha abierto siquiera el curso que acaba de grabar.
    //
    // Lo ESCRIBE solo el alumno, y aquí está lo importante: el entrenador NO
    // puede marcarle lecciones como vistas. Si pudiera, el dato dejaría de
    // significar "lo ha visto" y pasaría a significar "alguien dijo que lo
    // vio" — y el entrenador seguiría decidiendo sobre él igualmente, que es
    // lo que lo hace peligroso.
    match /courseProgress/{clientId} {
      allow read: if request.auth != null
        && (
          clientId == request.auth.uid
          || get(/databases/$(database)/documents/users/$(clientId)).data.trainerId
               == request.auth.uid
        );
      allow write: if request.auth != null && clientId == request.auth.uid;
    }

    // Pagos registrados por el entrenador (historial de ingresos).
    match /payments/{paymentId} {
      allow read: if request.auth != null
        && resource.data.trainerId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.trainerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.trainerId == request.auth.uid;
    }

    // Plantillas de rutina reutilizables del entrenador (solo suyas).
    match /routineTemplates/{templateId} {
      allow read: if request.auth != null
        && resource.data.trainerId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.trainerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.trainerId == request.auth.uid;
    }

    // Tests de nivel: marcas verificadas por el entrenador (el alumno las lee).
    match /levelTests/{testId} {
      allow read: if request.auth != null
        && (resource.data.trainerId == request.auth.uid || resource.data.clientId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.trainerId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.trainerId == request.auth.uid;
      allow update: if false;
    }

    // Rutinas asignadas a cada cliente.
    match /routines/{routineId} {
      allow read: if request.auth != null
        && (resource.data.trainerId == request.auth.uid || resource.data.clientId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.trainerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.trainerId == request.auth.uid;
    }

    // Entrenamientos registrados por cada cliente.
    match /workoutLogs/{logId} {
      allow read: if request.auth != null
        && (resource.data.trainerId == request.auth.uid || resource.data.clientId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.clientId == request.auth.uid;
      // El alumno puede borrar un entrenamiento pasado suyo; no se editan.
      allow delete: if request.auth != null
        && resource.data.clientId == request.auth.uid;
      allow update: if false;
    }

    // Registros de peso de cada cliente.
    match /weightLogs/{logId} {
      allow read: if request.auth != null
        && (resource.data.trainerId == request.auth.uid || resource.data.clientId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.clientId == request.auth.uid;
      // El alumno puede borrar un registro erróneo suyo; no se editan.
      allow delete: if request.auth != null
        && resource.data.clientId == request.auth.uid;
      allow update: if false;
    }

    // Planes nutricionales asignados a cada cliente.
    match /nutritionPlans/{planId} {
      allow read: if request.auth != null
        && (resource.data.trainerId == request.auth.uid || resource.data.clientId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.trainerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.trainerId == request.auth.uid;
    }

    // Libretas de comida del entrenador (recetas/fotos). Las sube el coach y
    // las leen TODOS sus alumnos (igual que la biblioteca de ejercicios).
    match /mealBooks/{bookId} {
      allow read: if request.auth != null
        && (
          resource.data.trainerId == request.auth.uid
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.trainerId == resource.data.trainerId
        );
      allow create: if request.auth != null
        && request.resource.data.trainerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.trainerId == request.auth.uid;
    }

    // Comidas registradas por cada cliente.
    match /mealLogs/{logId} {
      allow read: if request.auth != null
        && (resource.data.trainerId == request.auth.uid || resource.data.clientId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.clientId == request.auth.uid;
      allow update, delete: if false;
    }

    // Fotos de progreso: privadas, solo el propio cliente y su entrenador.
    match /progressPhotos/{photoId} {
      allow read: if request.auth != null
        && (resource.data.trainerId == request.auth.uid || resource.data.clientId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.clientId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.clientId == request.auth.uid;
      allow update: if false;
    }

    // Hábitos diarios asignados por el entrenador a un alumno.
    match /habits/{habitId} {
      allow read: if request.auth != null
        && (resource.data.trainerId == request.auth.uid || resource.data.clientId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.trainerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.trainerId == request.auth.uid;
    }

    // Registros diarios de hábitos: los crea y borra el propio alumno.
    match /habitLogs/{logId} {
      allow read: if request.auth != null
        && (resource.data.trainerId == request.auth.uid || resource.data.clientId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.clientId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.clientId == request.auth.uid;
      allow update: if false;
    }

    // Retos del grupo: los gestiona el entrenador; los leen sus alumnos.
    match /challenges/{challengeId} {
      allow read: if request.auth != null
        && (
          resource.data.trainerId == request.auth.uid
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.trainerId
            == resource.data.trainerId
        );
      allow create: if request.auth != null
        && request.resource.data.trainerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.trainerId == request.auth.uid;
    }

    // Check-ins semanales del alumno: los crea el propio alumno y los lee
    // también su entrenador. No se editan ni borran (registro histórico).
    match /checkIns/{checkInId} {
      allow read: if request.auth != null
        && (resource.data.trainerId == request.auth.uid || resource.data.clientId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.clientId == request.auth.uid;
      allow update, delete: if false;
    }

    // Estadísticas públicas para el ranking social del coaching. Solo
    // contienen métricas no sensibles (nombre, foto, racha, sesiones). Cada
    // usuario escribe únicamente las suyas; las leen los miembros del mismo
    // entrenador (y el propio entrenador).
    match /socialStats/{userId} {
      allow read: if request.auth != null
        && (
          resource.data.uid == request.auth.uid
          || resource.data.trainerId == request.auth.uid
          || resource.data.trainerId ==
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.trainerId
        );
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid;
      // El entrenador puede borrar la entrada de un alumno de su grupo (limpiar
      // la clasificación de perfiles antiguos o de prueba), y cada uno la suya:
      // esta ficha lleva el nombre a la vista, así que al borrarse la cuenta
      // tiene que poder irse con ella.
      allow delete: if request.auth != null
        && (
          resource.data.trainerId == request.auth.uid
          || resource.data.uid == request.auth.uid
        );
    }

    // Cursos en vídeo del entrenador. Los alumnos solo pueden leer los cursos
    // PUBLICADOS de su propio entrenador; el entrenador gestiona los suyos.
    match /courses/{courseId} {
      allow read: if request.auth != null
        && (
          resource.data.trainerId == request.auth.uid
          || (
            resource.data.published == true
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.trainerId
              == resource.data.trainerId
          )
        );
      allow create: if request.auth != null
        && request.resource.data.trainerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.trainerId == request.auth.uid;
    }

    // Ciclos de planificación (macro/meso/microciclos). Los gestiona el
    // entrenador para cada alumno; el alumno solo puede leer los suyos.
    match /trainingCycles/{cycleId} {
      allow read: if request.auth != null
        && (resource.data.trainerId == request.auth.uid || resource.data.clientId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.trainerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.trainerId == request.auth.uid;
    }

    // Plantillas de plan del entrenador: la temporada que aplica a varios
    // alumnos. Son suyas y de nadie más — ni siquiera sus alumnos las ven,
    // porque lo que el alumno tiene que ver es SU plan, no el molde.
    match /planTemplates/{templateId} {
      allow read, update, delete: if request.auth != null
        && resource.data.trainerId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.trainerId == request.auth.uid;
    }

    // Agenda del coach: tareas y objetivos de negocio. Totalmente privadas del
    // entrenador; nadie más las lee ni escribe.
    match /coachTasks/{taskId} {
      allow read, update, delete: if request.auth != null
        && resource.data.trainerId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.trainerId == request.auth.uid;
    }

    // Errores reales de los usuarios. Los escribe la app cuando algo se rompe,
    // para que dejemos de enterarnos de los fallos por WhatsApp (o por un
    // rechazo de Apple).
    //
    // Se permite escribir SIN sesión a propósito: los fallos más caros son los
    // del registro y el login, donde todavía no hay usuario. A cambio, el
    // documento se valida con dureza (campos exactos y longitudes acotadas)
    // para que no sirva de almacén gratuito, y nadie puede leerlo, editarlo ni
    // borrarlo salvo el CEO.
    // Contadores del embudo (una fila por día). No guardan nada personal: solo
    // cuántas veces ocurrió cada paso. Se escribe SIN sesión a propósito,
    // porque los pasos que más importan (ver la intro, abrir el registro)
    // ocurren antes de que exista un usuario.
    //
    // La protección está en que solo se pueden tocar contadores de la lista
    // conocida: `affectedKeys` funciona con `increment`, así que nadie puede
    // inventarse campos ni meter datos aquí.
    match /analytics/{day} {
      function isUdecaAdmin() {
        return request.auth != null
          && request.auth.token.email in [
            'luisetenete07@gmail.com',
            'luistenaf@gmail.com'
          ];
      }
      function knownCounters() {
        return [
          'intro_start', 'intro_done',
          'register_view', 'register_submit', 'register_ok', 'register_fail',
          'register_ok_trainer', 'register_ok_athlete', 'register_ok_client',
          'login_ok', 'paywall_view', 'checkout_start',
          'updatedAt'
        ];
      }
      allow read, delete: if isUdecaAdmin();
      allow create: if request.resource.data.keys().hasOnly(knownCounters());
      allow update: if request.resource.data.diff(resource.data)
        .affectedKeys().hasOnly(knownCounters());
    }

    match /errorLogs/{logId} {
      function isUdecaAdmin() {
        return request.auth != null
          && request.auth.token.email in [
            'luisetenete07@gmail.com',
            'luistenaf@gmail.com'
          ];
      }
      allow read, delete: if isUdecaAdmin();
      allow update: if false; // un error registrado no se reescribe
      allow create: if request.resource.data.keys().hasOnly([
            'message', 'stack', 'where', 'uid', 'fatal', 'platform', 'appVersion', 'createdAt'
          ])
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 300
        && (!('stack' in request.resource.data)
            || request.resource.data.stack.size() <= 2000)
        && (!('where' in request.resource.data)
            || request.resource.data.where.size() <= 200)
        // No se puede firmar un error en nombre de otro usuario.
        && (request.resource.data.uid == null
            || (request.auth != null && request.resource.data.uid == request.auth.uid))
        && request.resource.data.createdAt is int;
    }

    /**
     * Contactos de la comunidad privada (comunidad.udeca.app).
     *
     * Nadie entra aquí desde la app ni desde el navegador: los escribe el
     * servidor con el SDK de administrador, que no pasa por estas reglas. Se
     * deja escrito de forma explícita —en vez de confiar en el denegado por
     * defecto— porque es una lista de correos de personas y conviene que se vea
     * de un vistazo que está cerrada.
     */
    match /leads/{leadId} {
      allow read, write: if false;
    }

    /**
     * Huellas de tarjeta del alta de 1 € (qué cuentas ha pagado cada tarjeta).
     *
     * Cerrada por completo: la escribe el servidor con el SDK de
     * administrador, que no pasa por estas reglas. Ni se lee ni se toca desde
     * la app —es el mecanismo que impide multiplicar cuentas de entrenador, y
     * enseñarlo sería explicar cómo esquivarlo.
     */
    match /payerCards/{fingerprint} {
      allow read, write: if false;
    }

    /**
     * Altas de 1 € pagadas ANTES de existir la cuenta (las de la web).
     *
     * Cerrada por completo. Guarda el correo de quien pagó y la huella de su
     * tarjeta, y es lo que permite activar la cuenta cuando esa persona se
     * registra. Si se pudiera leer, sería una lista de correos de clientes; si
     * se pudiera escribir, cualquiera se regalaría el alta inventándose un
     * pago. La escribe el webhook y la consume api/claim-entry, los dos con
     * permisos de administrador, que no pasan por estas reglas.
     */
    match /entryPayments/{clave} {
      allow read, write: if false;
    }

    /**
     * Ajustes del servidor (entre ellos el enlace del grupo de Telegram).
     *
     * Cerrada a cal y canto: si se pudiera leer desde el navegador, el enlace
     * de la comunidad estaría a un clic y el formulario dejaría de ser una
     * puerta. Se escribe a mano desde la consola de Firebase o con el SDK de
     * administrador, que no pasa por estas reglas.
     */
    match /config/{docId} {
      allow read, write: if false;
    }
  }
}

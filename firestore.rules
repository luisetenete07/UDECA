rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Mapa público código -> trainerId, usado solo para vincular clientes
    // a su entrenador durante el registro. No contiene datos personales.
    match /trainerCodes/{code} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.trainerId == request.auth.uid;
      // El dueño puede reescribir o liberar sus propios códigos; nadie puede
      // apropiarse del código de otro entrenador (create solo aplica si el
      // documento no existe; update solo si ya es tuyo).
      allow update: if request.auth != null
        && resource.data.trainerId == request.auth.uid
        && request.resource.data.trainerId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.trainerId == request.auth.uid;
    }

    // Perfiles de usuario (entrenadores y clientes).
    match /users/{userId} {
      allow read: if request.auth != null
        && (
          request.auth.uid == userId
          || resource.data.trainerId == request.auth.uid
          // El alumno puede leer el perfil de SU entrenador (p. ej. para
          // enviarle una notificación al completar una sesión).
          || userId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.trainerId
        );
      allow create: if request.auth != null && request.auth.uid == userId;
      // El propio usuario edita su perfil; el entrenador puede cambiar el
      // `status` de sus clientes o sacarlos de su grupo (quitar `trainerId`).
      allow update: if request.auth != null && (
        request.auth.uid == userId
        || (
          resource.data.trainerId == request.auth.uid
          && (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'paymentStatus', 'monthlyFeeEur', 'nextPaymentDate'])
            || (
              // Sacar del grupo: se elimina el vínculo con el entrenador.
              !('trainerId' in request.resource.data)
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['trainerId', 'status', 'paymentStatus', 'monthlyFeeEur', 'nextPaymentDate'])
            )
          )
        )
      );
      // El propio usuario puede borrar su cuenta (su documento de perfil).
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Biblioteca de ejercicios de cada entrenador.
    match /exercises/{exerciseId} {
      allow read: if request.auth != null
        && (resource.data.trainerId == request.auth.uid
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.trainerId == resource.data.trainerId);
      allow create: if request.auth != null
        && request.resource.data.trainerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.trainerId == request.auth.uid;
    }

    // Rutinas asignadas a cada cliente.
    match /routines/{routineId} {
      allow read: if request.auth != null
        && (resource.data.trainerId == request.auth.uid || resource.data.clientId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.trainerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.trainerId == request.auth.uid;
    }

    // Entrenamientos registrados por cada cliente.
    match /workoutLogs/{logId} {
      allow read: if request.auth != null
        && (resource.data.trainerId == request.auth.uid || resource.data.clientId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.clientId == request.auth.uid;
      allow update, delete: if false;
    }

    // Registros de peso de cada cliente.
    match /weightLogs/{logId} {
      allow read: if request.auth != null
        && (resource.data.trainerId == request.auth.uid || resource.data.clientId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.clientId == request.auth.uid;
      // El alumno puede borrar un registro erróneo suyo; no se editan.
      allow delete: if request.auth != null
        && resource.data.clientId == request.auth.uid;
      allow update: if false;
    }

    // Medidas corporales de cada cliente.
    match /bodyMeasurements/{measurementId} {
      allow read: if request.auth != null
        && (resource.data.trainerId == request.auth.uid || resource.data.clientId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.clientId == request.auth.uid;
      // El alumno puede borrar una medición errónea suya; no se editan.
      allow delete: if request.auth != null
        && resource.data.clientId == request.auth.uid;
      allow update: if false;
    }

    // Planes nutricionales asignados a cada cliente.
    match /nutritionPlans/{planId} {
      allow read: if request.auth != null
        && (resource.data.trainerId == request.auth.uid || resource.data.clientId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.trainerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.trainerId == request.auth.uid;
    }

    // Comidas registradas por cada cliente.
    match /mealLogs/{logId} {
      allow read: if request.auth != null
        && (resource.data.trainerId == request.auth.uid || resource.data.clientId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.clientId == request.auth.uid;
      allow update, delete: if false;
    }

    // Fotos de progreso: privadas, solo el propio cliente y su entrenador.
    match /progressPhotos/{photoId} {
      allow read: if request.auth != null
        && (resource.data.trainerId == request.auth.uid || resource.data.clientId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.clientId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.clientId == request.auth.uid;
      allow update: if false;
    }

    // Anuncios del entrenador: los gestiona él; los leen sus alumnos.
    match /announcements/{announcementId} {
      allow read: if request.auth != null
        && (
          resource.data.trainerId == request.auth.uid
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.trainerId
            == resource.data.trainerId
        );
      allow create: if request.auth != null
        && request.resource.data.trainerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.trainerId == request.auth.uid;
    }

    // Hábitos diarios asignados por el entrenador a un alumno.
    match /habits/{habitId} {
      allow read: if request.auth != null
        && (resource.data.trainerId == request.auth.uid || resource.data.clientId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.trainerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.trainerId == request.auth.uid;
    }

    // Registros diarios de hábitos: los crea y borra el propio alumno.
    match /habitLogs/{logId} {
      allow read: if request.auth != null
        && (resource.data.trainerId == request.auth.uid || resource.data.clientId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.clientId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.clientId == request.auth.uid;
      allow update: if false;
    }

    // Retos del grupo: los gestiona el entrenador; los leen sus alumnos.
    match /challenges/{challengeId} {
      allow read: if request.auth != null
        && (
          resource.data.trainerId == request.auth.uid
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.trainerId
            == resource.data.trainerId
        );
      allow create: if request.auth != null
        && request.resource.data.trainerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.trainerId == request.auth.uid;
    }

    // Check-ins semanales del alumno: los crea el propio alumno y los lee
    // también su entrenador. No se editan ni borran (registro histórico).
    match /checkIns/{checkInId} {
      allow read: if request.auth != null
        && (resource.data.trainerId == request.auth.uid || resource.data.clientId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.clientId == request.auth.uid;
      allow update, delete: if false;
    }

    // Estadísticas públicas para el ranking social del coaching. Solo
    // contienen métricas no sensibles (nombre, foto, racha, sesiones). Cada
    // usuario escribe únicamente las suyas; las leen los miembros del mismo
    // entrenador (y el propio entrenador).
    match /socialStats/{userId} {
      allow read: if request.auth != null
        && (
          resource.data.uid == request.auth.uid
          || resource.data.trainerId == request.auth.uid
          || resource.data.trainerId ==
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.trainerId
        );
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // Cursos en vídeo del entrenador. Los alumnos solo pueden leer los cursos
    // PUBLICADOS de su propio entrenador; el entrenador gestiona los suyos.
    match /courses/{courseId} {
      allow read: if request.auth != null
        && (
          resource.data.trainerId == request.auth.uid
          || (
            resource.data.published == true
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.trainerId
              == resource.data.trainerId
          )
        );
      allow create: if request.auth != null
        && request.resource.data.trainerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.trainerId == request.auth.uid;
    }
  }
}
